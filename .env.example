# ==============================================================================
# GADAP Hub ERP - Template de Variáveis de Ambiente (Vercel Services)
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVIÇO: web (Next.js 14 App Router)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# SERVIÇO: api (FastAPI Microservice)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Evolution API WhatsApp Gateway
EVOLUTION_API_URL=https://whatsapp-ecostone.onrender.com
EVOLUTION_INSTANCE_NAME=ecostone
EVOLUTION_API_KEY=your_evolution_api_key

# Inteligência Artificial (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key
